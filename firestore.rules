rules_version = '2';
// قواعد حماية قاعدة بيانات «المعتق للعود»
// بريد المدير: almutiqoud@gmail.com
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['almutiqoud@gmail.com']; }
    function isApproved() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved'; }
    function myPaddle() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.paddle; }

    // المستخدمون: كل مستخدم يقرأ ويكتب ملفه فقط، ولا يغيّر رقم مزايدته بعد إنشائه
    // الأعضاء: تسجيل مبسّط بالاسم والجوال؛ والتسجيل الرسمي (وثيقة العمل الحر/السجل التجاري) لقسم التجار ويعتمده المدير
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.paddle == getAfter(/databases/$(database)/documents/counters/paddles).data.next - 1
        && request.resource.data.status in ['basic', 'pending'];
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.paddle == resource.data.paddle
        && (request.resource.data.get('status', '') == resource.data.get('status', '')
            || (request.resource.data.status == 'pending' && !(resource.data.get('status', '') in ['approved', 'rejected']))));
    }

    match /counters/paddles {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.next == 12;
      allow update: if signedIn() && request.resource.data.next == resource.data.next + 1;
    }

    function lotDoc(id) { return /databases/$(database)/documents/lots/$(id); }
    function hallKey(h) { return h == 'riyadh' ? 'current' : h; }
    function hallOk(h) { return h in ['riyadh', 'hijaz', 'east', 'south', 'north', 'intl']; }

    // المزاد: الكل يقرأ؛ المدير يكتب؛ والتاجر يبدأ مزاد منتجه إذا كانت القاعة فاضية
    match /auctions/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.status == 'live'
        && (resource == null
            ? request.resource.data.keys().hasOnly(['currentLotId', 'status', 'title'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentLotId', 'status', 'title']))
        && getAfter(lotDoc(request.resource.data.currentLotId)).data.get('ownerUid', '') == request.auth.uid
        && getAfter(lotDoc(request.resource.data.currentLotId)).data.status == 'live'
        && hallKey(getAfter(lotDoc(request.resource.data.currentLotId)).data.hall) == id
        && (resource == null
            || resource.data.get('currentLotId', null) == null
            || resource.data.currentLotId == request.resource.data.currentLotId
            || !exists(lotDoc(resource.data.currentLotId))
            || get(lotDoc(resource.data.currentLotId)).data.status != 'live');
    }

    // القطع: الكل يقرأ؛ المدير يكتب كل شيء؛ المستخدم يزايد فقط بشروط
    match /lots/{lotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // التاجر المعتمد يضيف منتجه إلى «المنتجات التالية»
      allow create: if isApproved()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'queued'
        && hallOk(request.resource.data.hall)
        && request.resource.data.openPrice is number && request.resource.data.openPrice > 0
        && request.resource.data.currentPrice == null && request.resource.data.bidCount == 0
        && request.resource.data.leaderUid == null && request.resource.data.endsAt == null
        && request.resource.data.lotMinutes is int && request.resource.data.lotMinutes >= 1 && request.resource.data.lotMinutes <= 30;
      // ويسحبه قبل البدء
      allow delete: if signedIn() && resource.data.get('ownerUid', '') == request.auth.uid && resource.data.status == 'queued';
      // ويبدأ مزاده بنفسه (مع تحديث شاشة القاعة في نفس العملية)
      allow update: if signedIn()
        && resource.data.get('ownerUid', '') == request.auth.uid
        && resource.data.status == 'queued'
        && request.resource.data.status == 'live'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentPrice', 'endsAt', 'leaderUid', 'leaderPaddle', 'bidCount'])
        && request.resource.data.currentPrice == resource.data.openPrice
        && request.resource.data.bidCount == 0 && request.resource.data.leaderUid == null
        && request.resource.data.endsAt > request.time
        && request.resource.data.endsAt <= request.time + duration.value(resource.data.lotMinutes * 60 + 60, 's')
        && getAfter(/databases/$(database)/documents/auctions/$(hallKey(resource.data.hall))).data.currentLotId == lotId;
      // إغلاق تلقائي بعد انتهاء الوقت من أي عضو داخل القاعة
      allow update: if signedIn()
        && resource.data.status == 'live'
        && request.time > resource.data.endsAt + duration.value(2, 's')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedBy', 'closedAt'])
        && request.resource.data.status == (resource.data.get('leaderUid', null) != null ? 'sold' : 'unsold');
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.get('ownerUid', '') != request.auth.uid
        && resource.data.status == 'live'
        && request.time < resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPrice', 'leaderUid', 'leaderPaddle', 'endsAt', 'bidCount'])
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderPaddle == myPaddle()
        && request.resource.data.currentPrice >= (resource.data.get('currentPrice', null) == null ? resource.data.openPrice : resource.data.currentPrice) + 50
        && request.resource.data.bidCount == resource.data.get('bidCount', 0) + 1
        && (request.resource.data.endsAt == resource.data.endsAt
            || request.resource.data.endsAt <= request.time + duration.value(40, 's'))
      );

      match /bids/{bidId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.paddle == myPaddle()
          && request.resource.data.amount == getAfter(/databases/$(database)/documents/lots/$(lotId)).data.currentPrice;
        allow update, delete: if isAdmin();
      }
    }

    // الفائزون: المدير يسجّل الترسية؛ الفائز يقرأ طلبه ويرفع إيصال التحويل فقط
    match /wins/{lotId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      // تسجيل الفائز تلقائياً مع إغلاق القطعة في نفس العملية
      allow create: if signedIn()
        && get(lotDoc(lotId)).data.status == 'live'
        && getAfter(lotDoc(lotId)).data.status == 'sold'
        && request.resource.data.lotId == lotId
        && request.resource.data.uid == get(lotDoc(lotId)).data.leaderUid
        && request.resource.data.amount == get(lotDoc(lotId)).data.currentPrice
        && request.resource.data.commissionPct == 5
        && request.resource.data.status == 'awaiting_payment';
      allow update: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt', 'status', 'receiptAt'])
        && request.resource.data.status == 'receipt_uploaded'
      );
    }

    // الحضور في قاعة المزاد
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // منتجات التجزئة وأسعار الجملة: الكل يقرأ، والمدير يكتب
    // قسم التجار: الدليل والمنتجات للأعضاء المعتمدين فقط
    match /directory/{uid} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    match /listings/{id} {
      allow read: if isApproved() || isAdmin();
      allow create: if isApproved() && request.resource.data.owner == request.auth.uid;
      allow update: if isApproved() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // المراسلة: الطرفان فقط (والمدير للأرشيف)، والرسائل لا تُعدَّل ولا تُحذف
    match /chats/{chatId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if isApproved() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;
      match /messages/{msgId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow create: if isApproved() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    // إعدادات الموقع (بيانات البنك والتواصل)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // بث التاجر: بعد موافقة الإدارة فقط، ولا يقاطع بثاً شغّالاً لغيره
      allow create, update: if id == 'live' && signedIn()
        && get(/databases/$(database)/documents/liveRequests/$(request.auth.uid)).data.status == 'approved'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['on', 'hall', 'title', 'startedAt', 'updatedAt', 'hostUid', 'hostName'])
        && request.resource.data.on is bool
        && (resource == null || resource.data.get('on', false) == false || resource.data.get('hostUid', '') == request.auth.uid);
    }
    // طلبات البث من التجار
    match /liveRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && isApproved()
        && request.resource.data.uid == uid && request.resource.data.status == 'pending'
        && (resource == null || resource.data.status != 'approved');
      // التاجر يُنهي موافقته بعد انتهاء بثه
      allow update: if signedIn() && request.auth.uid == uid && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'used';
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'pending');
      allow update: if isAdmin();
    }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /wholesale/{id} { allow read: if true; allow write: if isAdmin(); }

    // الطلبات: أي زائر يرسل طلباً جديداً؛ المدير فقط يقرأ ويعدّل
    match /quotes/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.items is list && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin();
    }
  }
}
