rules_version = '2';
// قواعد حماية قاعدة بيانات «المعتق للعود»
// بريد المدير: almutiqoud@gmail.com
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['almutiqoud@gmail.com']; }
    function isApproved() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'approved'; }
    function myPaddle() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.paddle; }

    // المستخدمون: كل مستخدم يقرأ ويكتب ملفه فقط، ولا يغيّر رقم مزايدته بعد إنشائه
    // الأعضاء: تسجيل مبسّط بالاسم والجوال؛ والتسجيل الرسمي (وثيقة العمل الحر/السجل التجاري) لقسم التجار ويعتمده المدير
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.paddle == getAfter(/databases/$(database)/documents/counters/paddles).data.next - 1
        && request.resource.data.status in ['basic', 'pending'];
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.paddle == resource.data.paddle
        && (request.resource.data.get('status', '') == resource.data.get('status', '')
            || (request.resource.data.status == 'pending' && !(resource.data.get('status', '') in ['approved', 'rejected']))));
    }

    match /counters/paddles {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.next == 12;
      allow update: if signedIn() && request.resource.data.next == resource.data.next + 1;
    }

    // المزاد: الكل يقرأ، والمدير فقط يكتب
    match /auctions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // القطع: الكل يقرأ؛ المدير يكتب كل شيء؛ المستخدم يزايد فقط بشروط
    match /lots/{lotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.status == 'live'
        && request.time < resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPrice', 'leaderUid', 'leaderPaddle', 'endsAt', 'bidCount'])
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderPaddle == myPaddle()
        && request.resource.data.currentPrice >= (resource.data.get('currentPrice', null) == null ? resource.data.openPrice : resource.data.currentPrice) + 50
        && request.resource.data.bidCount == resource.data.get('bidCount', 0) + 1
        && (request.resource.data.endsAt == resource.data.endsAt
            || request.resource.data.endsAt <= request.time + duration.value(40, 's'))
      );

      match /bids/{bidId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.paddle == myPaddle()
          && request.resource.data.amount == getAfter(/databases/$(database)/documents/lots/$(lotId)).data.currentPrice;
        allow update, delete: if isAdmin();
      }
    }

    // الفائزون: المدير يسجّل الترسية؛ الفائز يقرأ طلبه ويرفع إيصال التحويل فقط
    match /wins/{lotId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt', 'status', 'receiptAt'])
        && request.resource.data.status == 'receipt_uploaded'
      );
    }

    // الحضور في قاعة المزاد
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // منتجات القطاعي وأسعار الجملة: الكل يقرأ، والمدير يكتب
    // قسم التجار: الدليل والمنتجات للأعضاء المعتمدين فقط
    match /directory/{uid} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    match /listings/{id} {
      allow read: if isApproved() || isAdmin();
      allow create: if isApproved() && request.resource.data.owner == request.auth.uid;
      allow update: if isApproved() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // المراسلة: الطرفان فقط (والمدير للأرشيف)، والرسائل لا تُعدَّل ولا تُحذف
    match /chats/{chatId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if isApproved() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;
      match /messages/{msgId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
        allow create: if isApproved() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    // إعدادات الموقع (بيانات البنك والتواصل)
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /wholesale/{id} { allow read: if true; allow write: if isAdmin(); }

    // الطلبات: أي زائر يرسل طلباً جديداً؛ المدير فقط يقرأ ويعدّل
    match /quotes/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new' && request.resource.data.items is list && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin();
    }
  }
}
